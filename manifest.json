{
  "manifest_version": 3,
  "name": "Rapid Response Alerter",
  "version": "3.1.9",
  "description": "Watches the support wallboard and alerts on new tickets and first-response deadlines that are about to expire.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://servicenext.absc.nl/*",
    "https://abws.absc.nl/*"
  ],
  "optional_host_permissions": [
    "https://*.environment.api.powerplatform.com/*",
    "https://*.logic.azure.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://abws.absc.nl/Generic/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Rapid Response Alerter",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
